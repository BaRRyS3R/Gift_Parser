-- 9. RLS (Row Level Security) policies
ALTER TABLE tournaments ENABLE ROW LEVEL SECURITY;
ALTER TABLE tournament_leaderboard ENABLE ROW LEVEL SECURITY;

-- Allow read access to tournaments for all authenticated users
CREATE POLICY "Public read access for tournaments" ON tournaments
    FOR SELECT USING (true);

-- Allow read access to tournament_leaderboard for all authenticated users
CREATE POLICY "Public read access for tournament_leaderboard" ON tournament_leaderboard
    FOR SELECT USING (true);

-- Allow users to insert their own tournament results
CREATE POLICY "Users can insert own tournament results" ON tournament_leaderboard
    FOR INSERT WITH CHECK (true);

-- Allow users to update their own tournament results
CREATE POLICY "Users can update own tournament results" ON tournament_leaderboard
    FOR UPDATE USING (true);

-- Update trigger for tournaments
CREATE OR REPLACE FUNCTION update_tournaments_updated_at()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ language 'plpgsql';

CREATE TRIGGER update_tournaments_updated_at
    BEFORE UPDATE ON tournaments
    FOR EACH ROW
    EXECUTE FUNCTION update_tournaments_updated_at();