create view public.overall_leaderboard as
select
  id,
  telegram_id,
  first_name,
  last_name,
  username,
  is_premium,
  best_score,
  total_games,
  last_played_at,
  row_number() over (
    order by
      best_score desc
  ) as rank
from
  users
where
  total_games > 0
order by
  best_score desc;