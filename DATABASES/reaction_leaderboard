create view public.reaction_leaderboard as
select
  id,
  telegram_id,
  first_name,
  last_name,
  username,
  is_premium,
  reaction_best_time,
  reaction_games,
  reaction_best_score,
  last_played_at,
  row_number() over (
    order by
      reaction_best_time,
      reaction_best_score desc
  ) as rank
from
  users
where
  reaction_games > 0
  and reaction_best_time > 0
order by
  reaction_best_time,
  reaction_best_score desc;