create table public.user_task_completions (
  id uuid not null default gen_random_uuid (),
  user_id uuid not null,
  task_id uuid not null,
  started_at timestamp with time zone null default now(),
  completed_at timestamp with time zone null,
  claimed_at timestamp with time zone null,
  status text null default 'started'::text,
  created_at timestamp with time zone null default now(),
  updated_at timestamp with time zone null default now(),
  constraint user_task_completions_pkey primary key (id),
  constraint user_task_completions_user_id_task_id_claimed_at_key unique (user_id, task_id, claimed_at),
  constraint user_task_completions_task_id_fkey foreign KEY (task_id) references tasks (id) on delete CASCADE,
  constraint user_task_completions_user_id_fkey foreign KEY (user_id) references users (id) on delete CASCADE,
  constraint user_task_completions_status_check check (
    (
      status = any (
        array[
          'started'::text,
          'completed'::text,
          'claimed'::text
        ]
      )
    )
  )
) TABLESPACE pg_default;

create index IF not exists idx_user_task_completions_user_id on public.user_task_completions using btree (user_id) TABLESPACE pg_default;

create index IF not exists idx_user_task_completions_task_id on public.user_task_completions using btree (task_id) TABLESPACE pg_default;

create index IF not exists idx_user_task_completions_status on public.user_task_completions using btree (status) TABLESPACE pg_default;

create trigger update_user_task_completions_updated_at BEFORE
update on user_task_completions for EACH row
execute FUNCTION update_updated_at_column ();