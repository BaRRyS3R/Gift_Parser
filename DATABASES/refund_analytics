create view public.refund_analytics as
select
  p.id,
  p.transaction_id,
  p.telegram_id,
  u.first_name,
  u.username,
  p.product_type,
  p.amount_stars,
  p.created_at as purchase_date,
  p.refunded_at,
  p.refund_reason,
  p.refunded_by,
  EXTRACT(
    epoch
    from
      p.refunded_at - p.created_at
  ) / 86400::numeric as days_to_refund
from
  purchases p
  join users u on p.user_id = u.id
where
  p.status::text = 'refunded'::text
order by
  p.refunded_at desc;