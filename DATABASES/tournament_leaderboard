create table public.tournament_leaderboard (
  id uuid not null default gen_random_uuid (),
  tournament_id uuid not null,
  user_id uuid not null,
  telegram_id bigint not null,
  survival_time bigint not null,
  survival_score integer not null,
  max_level_reached integer not null,
  perfect_streak integer not null,
  correct_hits integer not null,
  death_cause text not null,
  created_at timestamp with time zone null default now(),
  games_played integer null default 1,
  updated_at timestamp with time zone null default now(),
  last_game_score integer null default 0,
  constraint tournament_leaderboard_pkey primary key (id),
  constraint unique_user_tournament unique (tournament_id, user_id),
  constraint tournament_leaderboard_tournament_id_fkey foreign KEY (tournament_id) references tournaments (id) on delete CASCADE,
  constraint tournament_leaderboard_user_id_fkey foreign KEY (user_id) references users (id) on delete CASCADE
) TABLESPACE pg_default;

create index IF not exists idx_tournament_leaderboard_tournament_user on public.tournament_leaderboard using btree (tournament_id, user_id) TABLESPACE pg_default;

create index IF not exists idx_tournament_leaderboard_score_ranking on public.tournament_leaderboard using btree (
  tournament_id,
  survival_score desc,
  survival_time desc
) TABLESPACE pg_default;

create index IF not exists idx_tournament_leaderboard_last_game on public.tournament_leaderboard using btree (tournament_id, last_game_score desc) TABLESPACE pg_default;

create index IF not exists idx_tournament_leaderboard_tournament_time on public.tournament_leaderboard using btree (tournament_id, survival_time desc) TABLESPACE pg_default;

create index IF not exists idx_tournament_leaderboard_user on public.tournament_leaderboard using btree (user_id) TABLESPACE pg_default;