create table public.purchases (
  id uuid not null default gen_random_uuid (),
  user_id uuid not null,
  telegram_id bigint not null,
  transaction_id character varying(255) not null,
  amount_stars integer not null,
  product_type character varying(50) not null default 'additional_attempts'::character varying,
  status character varying(20) not null default 'completed'::character varying,
  created_at timestamp with time zone null default now(),
  updated_at timestamp with time zone null default now(),
  refund_reason text null,
  refunded_at timestamp with time zone null,
  refunded_by character varying(100) null,
  constraint purchases_pkey primary key (id),
  constraint purchases_transaction_id_key unique (transaction_id),
  constraint purchases_user_id_fkey foreign KEY (user_id) references users (id) on delete CASCADE,
  constraint check_amount_stars_positive check ((amount_stars > 0)),
  constraint check_product_type_valid check (
    (
      (product_type)::text = any (
        (
          array[
            'attempts_1'::character varying,
            'attempts_5'::character varying,
            'attempts_10'::character varying,
            'attempts_100'::character varying,
            'instant_reset'::character varying
          ]
        )::text[]
      )
    )
  ),
  constraint check_status_valid check (
    (
      (status)::text = any (
        (
          array[
            'pending'::character varying,
            'completed'::character varying,
            'failed'::character varying,
            'refunded'::character varying
          ]
        )::text[]
      )
    )
  )
) TABLESPACE pg_default;

create index IF not exists idx_purchases_user_id on public.purchases using btree (user_id) TABLESPACE pg_default;

create index IF not exists idx_purchases_telegram_id on public.purchases using btree (telegram_id) TABLESPACE pg_default;

create index IF not exists idx_purchases_transaction_id on public.purchases using btree (transaction_id) TABLESPACE pg_default;

create index IF not exists idx_purchases_created_at on public.purchases using btree (created_at) TABLESPACE pg_default;

create index IF not exists idx_purchases_product_type on public.purchases using btree (product_type) TABLESPACE pg_default;

create index IF not exists idx_purchases_status on public.purchases using btree (status) TABLESPACE pg_default;

create index IF not exists idx_purchases_refunded_at on public.purchases using btree (refunded_at) TABLESPACE pg_default;

create index IF not exists idx_purchases_refundable on public.purchases using btree (status, created_at) TABLESPACE pg_default
where
  ((status)::text = 'completed'::text);

create index IF not exists idx_purchases_refunded_by on public.purchases using btree (refunded_by) TABLESPACE pg_default
where
  (refunded_by is not null);

create trigger trigger_log_refunds
after
update on purchases for EACH row
execute FUNCTION log_refund_change ();

create trigger update_purchases_updated_at BEFORE
update on purchases for EACH row
execute FUNCTION update_updated_at_column ();