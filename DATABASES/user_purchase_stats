create view public.user_purchase_stats as
select
  u.id as user_id,
  u.telegram_id,
  u.first_name,
  u.username,
  count(p.id) as total_purchases,
  sum(p.amount_stars) as total_stars_spent,
  count(
    case
      when p.status::text = 'completed'::text then 1
      else null::integer
    end
  ) as completed_purchases,
  count(
    case
      when p.status::text = 'refunded'::text then 1
      else null::integer
    end
  ) as refunded_purchases,
  sum(
    case
      when p.status::text = 'refunded'::text then p.amount_stars
      else 0
    end
  ) as total_refunded_stars,
  min(p.created_at) as first_purchase_date,
  max(p.created_at) as last_purchase_date,
  max(p.refunded_at) as last_refund_date
from
  users u
  left join purchases p on u.id = p.user_id
group by
  u.id,
  u.telegram_id,
  u.first_name,
  u.username;