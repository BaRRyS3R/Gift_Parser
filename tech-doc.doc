│   └── useNFT.ts           # Интеграция с TON
├── services/               # Сервисы и API
│   ├── api.ts              # Основной API-клиент
│   ├── ton.ts              # Сервис для работы с TON
│   └── matchmaking.ts      # Сервис подбора соперников
├── stores/                 # Хранилища состояния (Zustand)
│   ├── gameStore.ts        # Хранилище игры
│   ├── userStore.ts        # Хранилище пользователя
│   └── collectionStore.ts  # Хранилище коллекции
├── types/                  # Типы TypeScript
│   ├── game.ts             # Типы игры
│   ├── card.ts             # Типы карт
