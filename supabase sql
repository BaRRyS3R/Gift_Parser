-- Расширение для поддержки UUID (если еще не активировано)
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- Создание таблицы пользователей для Telegram Mini App
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    telegram_id BIGINT UNIQUE NOT NULL,
    first_name VARCHAR(255) NOT NULL,
    last_name VARCHAR(255),
    username VARCHAR(255),
    language_code VARCHAR(10),
    is_premium BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),
    
    -- Статистика игры
    total_games INTEGER DEFAULT 0,
    total_score INTEGER DEFAULT 0,
    best_score INTEGER DEFAULT 0,
    total_correct_hits INTEGER DEFAULT 0,
    total_wrong_hits INTEGER DEFAULT 0,
    total_missed_circles INTEGER DEFAULT 0,
    best_accuracy DECIMAL(5,2) DEFAULT 0.00,
    
    -- Статистика по уровням сложности
    easy_games INTEGER DEFAULT 0,
    easy_best_score INTEGER DEFAULT 0,
    medium_games INTEGER DEFAULT 0,
    medium_best_score INTEGER DEFAULT 0,
    hard_games INTEGER DEFAULT 0,
    hard_best_score INTEGER DEFAULT 0,
    legendary_games INTEGER DEFAULT 0,
    legendary_best_score INTEGER DEFAULT 0,
    omg_games INTEGER DEFAULT 0,
    omg_best_score INTEGER DEFAULT 0,
    
    -- Дополнительные поля
    last_played_at TIMESTAMPTZ,
    is_active BOOLEAN DEFAULT TRUE
);

-- Создание индексов для оптимизации запросов
CREATE INDEX idx_users_telegram_id ON users(telegram_id);
CREATE INDEX idx_users_created_at ON users(created_at);
CREATE INDEX idx_users_last_played_at ON users(last_played_at);

-- Создание функции для автоматического обновления updated_at
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ language 'plpgsql';

-- Создание триггера для автоматического обновления updated_at
CREATE TRIGGER update_users_updated_at 
    BEFORE UPDATE ON users 
    FOR EACH ROW 
    EXECUTE FUNCTION update_updated_at_column();

-- Создание таблицы для хранения результатов игр
CREATE TABLE game_results (
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    difficulty VARCHAR(20) NOT NULL,
    score INTEGER NOT NULL,
    correct_hits INTEGER NOT NULL,
    wrong_hits INTEGER NOT NULL,
    missed_circles INTEGER NOT NULL,
    accuracy DECIMAL(5,2) NOT NULL,
    duration INTEGER NOT NULL, -- в секундах
    created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Индексы для таблицы результатов
CREATE INDEX idx_game_results_user_id ON game_results(user_id);
CREATE INDEX idx_game_results_difficulty ON game_results(difficulty);
CREATE INDEX idx_game_results_score ON game_results(score);
CREATE INDEX idx_game_results_created_at ON game_results(created_at);

-- RLS (Row Level Security) политики
ALTER TABLE users ENABLE ROW LEVEL SECURITY;
ALTER TABLE game_results ENABLE ROW LEVEL SECURITY;

-- Политика для пользователей (каждый может видеть только свои данные)
CREATE POLICY "Users can view own data" ON users
    FOR SELECT USING (true); -- Для простоты разрешаем чтение всем

CREATE POLICY "Users can update own data" ON users
    FOR UPDATE USING (true);

CREATE POLICY "Users can insert own data" ON users
    FOR INSERT WITH CHECK (true);

-- Политика для результатов игр
CREATE POLICY "Users can view own game results" ON game_results
    FOR SELECT USING (true);

CREATE POLICY "Users can insert own game results" ON game_results
    FOR INSERT WITH CHECK (true);